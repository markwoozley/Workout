/* ════════════════════════════════════════
   LIST SCREEN
════════════════════════════════════════ */
function ListScreen({ acts, log, onHome, onPick }) {
  const today = todayStr();
  const ordered = useMemo(() => buildOrder(acts), [acts]);
  const done = useMemo(() => new Set(log.filter(e=>e.date===today).map(e=>e.name)), [log, today]);
  const remaining = ordered.filter(a => !done.has(a.name));
  const todayTotal = useMemo(() =>
    log.filter(e=>e.date===today&&e.sets)
       .reduce((s,e)=>s+e.sets.reduce((a,st)=>a+nv(st.weight)*(nv(st.reps)||nv(st.leftReps)+nv(st.rightReps)),0),0),
    [log, today]);

  if (!remaining.length) return (
    <div style={S.page}>
      <button style={S.back} onClick={onHome} ><ArrowLeft size={16}/> Home</button>
      <div style={{...S.surf,padding:24,textAlign:"center",marginTop:24}}>
        <span style={{...S.accent,display:"block",marginBottom:12}}><Check size={30}/></span>
        <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>Workout Complete</h2>
        <p style={{fontSize:14,marginBottom:16,...S.muted}}>Every activity logged for today.</p>
        <div style={{fontSize:24,fontFamily:"'Courier New',Courier,monospace",...S.text}}>{Math.round(todayTotal).toLocaleString()} lb</div>
        <div style={{...S.eyebrow,marginTop:4}}>Total lifted today</div>
      </div>
      <button style={{...S.btnOut,marginTop:20}} onClick={onHome}>Back to Home</button>
    </div>
  );

  return (
    <div style={S.page}>
      <button style={{...S.back,marginBottom:14}} onClick={onHome}><ArrowLeft size={16}/> Home</button>
      <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>Today's Workout</h2>
      <p style={{fontSize:14,marginBottom:14,...S.muted}}>Pick the next activity.</p>

      {/* progress bar */}
      <div style={{display:"flex",gap:3,marginBottom:22}}>
        {ordered.map(a => (
          <span key={a.name} style={{height:8,flex:1,borderRadius:9999,background:done.has(a.name)?CAT_COLOR[a.cat]:"#3A362F"}} title={a.name}/>
        ))}
      </div>

      <div style={{display:"flex",flexDirection:"column",gap:8}}>
        {remaining.map(a => (
          <button key={a.name} style={S.card} onClick={()=>onPick(a)}>
            <Dot cat={a.cat}/>
            <div style={{flex:1}}>
              <div style={{fontWeight:600,...S.text}}>{a.name}</div>
              <div style={S.eyeSm}>{a.cat}</div>
            </div>
            <span style={S.muted2}><ChevronRight size={18}/></span>
          </button>
        ))}
      </div>
    </div>
  );
}

/* ════════════════════════════════════════
   ACTIVITY SCREEN
════════════════════════════════════════ */
function ActivityScreen({ activity, lastEntry, onBack, onHome, onSave }) {
  const isCardio = activity.type === "cardio";
  const isRotary = activity.type === "rotary";

  const [entry, setEntry] = useState(() => {
    const e = blankEntry();
    if (isCardio) {
      e.incline = lastEntry ? (lastEntry.incline ?? "") : "";
      e.speed   = lastEntry ? (lastEntry.speed   ?? "") : "";
      e.incCarried = e.incline !== "";
      e.spdCarried = e.speed   !== "";
    } else {
      [0,1,2].forEach(i => {
        const w = lastEntry && lastEntry.sets && lastEntry.sets[i] ? (lastEntry.sets[i].weight ?? "") : "";
        e.sets[i].weight  = w;
        e.sets[i].carried = w !== "";
      });
    }
    return e;
  });

  function handleField(key, val) {
    if (key === "incline") { setEntry(e => ({...e, incline:val, incTouched:true})); return; }
    if (key === "speed")   { setEntry(e => ({...e, speed:val,   spdTouched:true})); return; }
    if (key === "time")    { setEntry(e => ({...e, time:val}));                      return; }
    const m = key.match(/^(\d+)-(weight|reps|leftReps|rightReps)$/);
    if (m) {
      const i = parseInt(m[1]), sub = m[2];
      setEntry(e => {
        const sets = e.sets.map((s,idx) => idx===i ? {...s,[sub]:val,...(sub==="weight"?{touched:true}:{})} : s);
        return {...e, sets};
      });
    }
  }

  function save() {
    const rec = { id:Date.now(), date:todayStr(), name:activity.name, cat:activity.cat, type:activity.type, rating:entry.rating };
    if (isCardio) {
      rec.incline = entry.incline; rec.speed = entry.speed; rec.time = entry.time;
    } else {
      rec.sets = entry.sets.map(s => ({ weight:s.weight, reps:s.reps, leftReps:s.leftReps, rightReps:s.rightReps }));
    }
    onSave(rec);
  }

  return (
    <div style={S.page}>
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:16}}>
        <button style={S.back} onClick={onBack}><ArrowLeft size={16}/> Activities</button>
        <button style={{...S.back,textDecoration:"underline",textUnderlineOffset:3}} onClick={onHome}>Summary</button>
      </div>
      <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:4}}>
        <Dot cat={activity.cat}/>
        <span style={{...S.eyebrow,display:"inline",margin:0}}>{activity.cat}</span>
      </div>
      <h2 style={{fontSize:22,fontWeight:700,letterSpacing:"0.06em",textTransform:"uppercase",...S.text,marginBottom:22}}>{activity.name}</h2>

      {isCardio && (
        <div style={{...S.surf,padding:16,display:"flex",flexDirection:"column",gap:14}}>
          <NumField label="Incline" fkey="incline" value={entry.incline} onChange={handleField} suffix="%" carried={entry.incCarried&&!entry.incTouched}/>
          <NumField label="Speed"   fkey="speed"   value={entry.speed}   onChange={handleField} suffix="mph" carried={entry.spdCarried&&!entry.spdTouched}/>
          <NumField label="Time"    fkey="time"    value={entry.time}    onChange={handleField} suffix="min"/>
        </div>
      )}

      {isRotary && (
        <div style={{display:"flex",flexDirection:"column",gap:12}}>
          {entry.sets.map((s,i) => (
            <div key={i} style={{...S.surf,padding:16}}>
              <span style={{...S.eyebrow}}>Set {i+1}</span>
              <NumField label="Weight" fkey={`${i}-weight`} value={s.weight} onChange={handleField} suffix="lb" carried={s.carried&&!s.touched}/>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginTop:10}}>
                <NumField label="Left Reps"  fkey={`${i}-leftReps`}  value={s.leftReps}  onChange={handleField}/>
                <NumField label="Right Reps" fkey={`${i}-rightReps`} value={s.rightReps} onChange={handleField}/>
              </div>
            </div>
          ))}
        </div>
      )}

      {!isCardio && !isRotary && (
        <div style={{display:"flex",flexDirection:"column",gap:12}}>
          {entry.sets.map((s,i) => (
            <div key={i} style={{...S.surf,padding:16}}>
              <span style={{...S.eyebrow}}>Set {i+1}</span>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
                <NumField label="Weight" fkey={`${i}-weight`} value={s.weight} onChange={handleField} suffix="lb" carried={s.carried&&!s.touched}/>
                <NumField label="Reps"   fkey={`${i}-reps`}   value={s.reps}   onChange={handleField}/>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Effort rating */}
      <div style={{...S.surf,padding:16,marginTop:22}}>
        <span style={S.eyebrow}>How did it feel?</span>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:8,marginTop:4}}>
          {[
            {key:"easy",     label:"😌 Easy",     bg:"#2A3D2E", border:"#4A8C7C", text:"#7AC4A8"},
            {key:"good",     label:"💪 Good",     bg:"#2D2A1A", border:"#D9A441", text:"#D9A441"},
            {key:"too_hard", label:"🔥 Too Hard", bg:"#3D2020", border:"#B2593F", text:"#E07050"},
          ].map(r => (
            <button key={r.key} onClick={()=>setEntry(e=>({...e, rating: e.rating===r.key ? null : r.key}))}
              style={{
                background:  entry.rating===r.key ? r.bg : "transparent",
                border:      `1px solid ${entry.rating===r.key ? r.border : "#3A362F"}`,
                color:       entry.rating===r.key ? r.text : "#8A8478",
                borderRadius:6, padding:"10px 4px", fontSize:12, fontFamily:"inherit",
                cursor:"pointer", textAlign:"center", transition:"all 0.15s",
                fontWeight:  entry.rating===r.key ? 600 : 400,
              }}>
              {r.label}
            </button>
          ))}
        </div>
      </div>

      <button style={{...S.btn,marginTop:14}} onClick={save}>
        <Check size={18}/> Save &amp; Continue
      </button>
    </div>
  );
}

/* ════════════════════════════════════════
   MANAGE SCREEN
════════════════════════════════════════ */
function ManageScreen({ acts, onBack, onAdd, onDelete }) {
  const [form, setForm] = useState({ name:"", cat:"Arm & Shoulder", type:"strength" });
  function add() {
    const nm = form.name.trim();
    if (!nm) return;
    if (acts.some(a => a.name.toLowerCase()===nm.toLowerCase())) return;
    onAdd({ name:nm, cat:form.cat, type:form.type });
    setForm(f => ({...f, name:""}));
  }
  return (
    <div style={S.page}>
      <button style={{...S.back,marginBottom:18}} onClick={onBack}><ArrowLeft size={16}/> Home</button>
      <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>Activities</h2>
      <p style={{fontSize:14,marginBottom:20,...S.muted}}>Add or remove workout activities.</p>

      <div style={{...S.surf,padding:16,marginBottom:16}}>
        <span style={S.eyebrow}>Add New</span>
        <div style={{display:"flex",flexDirection:"column",gap:10,marginTop:4}}>
          <label><span style={S.eyebrow}>Name</span>
            <input style={S.ti} value={form.name} placeholder="e.g. Cable Fly"
              onChange={e=>setForm(f=>({...f,name:e.target.value}))}/>
          </label>
          <label><span style={S.eyebrow}>Category</span>
            <select style={S.si} value={form.cat} onChange={e=>setForm(f=>({...f,cat:e.target.value}))}>
              {CATS.map(c=><option key={c} value={c}>{c}</option>)}
            </select>
          </label>
          <label><span style={S.eyebrow}>Type</span>
            <select style={S.si} value={form.type} onChange={e=>setForm(f=>({...f,type:e.target.value}))}>
              {Object.entries(TYPES).map(([k,v])=><option key={k} value={k}>{v}</option>)}
            </select>
          </label>
          <button style={{...S.btn,marginTop:4}} onClick={add}><Plus size={15}/> Add Activity</button>
        </div>
      </div>

      <div style={{...S.surf,padding:16}}>
        <span style={S.eyebrow}>All Activities ({acts.length})</span>
        {acts.map(a => (
          <div key={a.name} style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"11px 0",borderBottom:"1px solid #2E2C28"}}>
            <div style={{display:"flex",alignItems:"center",gap:10}}>
              <Dot cat={a.cat} size={9}/>
              <div>
                <div style={{fontSize:14,...S.text}}>{a.name}</div>
                <div style={S.eyeSm}>{a.cat}</div>
              </div>
            </div>
            <button style={S.btnDel} onClick={()=>onDelete(a.name)}><Trash2 size={14}/></button>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ════════════════════════════════════════
   GRAPH SCREEN
════════════════════════════════════════ */
function GraphScreen({ weightLog, onBack }) {
  const [range, setRange] = useState("month");
  const rangeDays = { week:7, month:30, "3m":90, "6m":180, year:365 };

  const chartData = useMemo(() => {
    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - rangeDays[range]);
    const cs = cutoff.toISOString().slice(0,10);
    return weightLog.filter(d => d.date >= cs).map(d => ({ date:fmtDate(d.date), weight:d.weight }));
  }, [weightLog, range]);

  const recent = [...weightLog].reverse().slice(0,10);

  return (
    <div style={S.page}>
      <button style={{...S.back,marginBottom:18}} onClick={onBack}><ArrowLeft size={16}/> Home</button>
      <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>Body Weight</h2>
      <p style={{fontSize:14,marginBottom:16,...S.muted}}>Auto-logged when you update weight on the home screen.</p>

      <div style={{...S.surf,padding:16,marginBottom:14}}>
        {/* range selector */}
        <div style={{display:"flex",gap:6,marginBottom:16}}>
          {["week","month","3m","6m","year"].map(r => (
            <button key={r} style={{...S.rngBtn,...(range===r?S.rngBtnOn:{})}} onClick={()=>setRange(r)}>
              {{week:"Week",month:"Month","3m":"3M","6m":"6M",year:"Year"}[r]}
            </button>
          ))}
        </div>

        {chartData.length < 2
          ? <p style={{fontSize:14,textAlign:"center",padding:"40px 0",...S.muted}}>
              {chartData.length===0 ? "No data in this range. Update your weight on the home screen to track it." : `${chartData[0].weight} lb on ${chartData[0].date}`}
            </p>
          : <ResponsiveContainer width="100%" height={160}>
              <LineChart data={chartData} margin={{top:10,right:10,left:-20,bottom:0}}>
                <CartesianGrid strokeDasharray="3 3" stroke="#2A2825"/>
                <XAxis dataKey="date" tick={{fontSize:9,fill:"#6E695E"}} tickLine={false} axisLine={false}
                  interval={Math.max(0,Math.floor(chartData.length/3)-1)}/>
                <YAxis tick={{fontSize:9,fill:"#6E695E"}} tickLine={false} axisLine={false}
                  domain={["auto","auto"]}/>
                <Tooltip contentStyle={{background:"#211F1B",border:"1px solid #3A362F",borderRadius:6,fontSize:12,color:"#F2EFE9"}}/>
                <Line type="monotone" dataKey="weight" stroke="#D9A441" strokeWidth={2} dot={{fill:"#D9A441",r:3}} activeDot={{r:5}}/>
              </LineChart>
            </ResponsiveContainer>
        }
      </div>

      {recent.length > 0 && (
        <div style={{...S.surf,padding:16}}>
          <span style={S.eyebrow}>Recent Entries</span>
          {recent.map((d,i) => (
            <div key={i} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"9px 0",borderBottom:"1px solid #2E2C28"}}>
              <span style={{fontSize:14,...S.text}}>{fmtDate(d.date)}</span>
              <span style={{fontSize:16,fontFamily:"'Courier New',Courier,monospace",...S.text}}>{d.weight} lb</span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

