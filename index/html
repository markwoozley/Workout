/* ════════════════════════════════════════
   HISTORY SCREEN
════════════════════════════════════════ */
const RATING_LABEL = { easy:"😌 Easy", good:"💪 Good", too_hard:"🔥 Too Hard" };
const RATING_COLOR = { easy:"#7AC4A8", good:"#D9A441", too_hard:"#E07050" };

function HistoryScreen({ log, onBack, onDeleteEntry, onDeleteDay }) {
  const [expanded, setExpanded] = useState({});

  // Group log entries by date, most recent first
  const byDay = useMemo(() => {
    const days = {};
    log.forEach(e => { if (!days[e.date]) days[e.date] = []; days[e.date].push(e); });
    return Object.entries(days).sort((a,b) => b[0].localeCompare(a[0]));
  }, [log]);

  function toggle(date) {
    setExpanded(prev => ({...prev, [date]: !prev[date]}));
  }

  function dayTotal(entries) {
    return entries.filter(e => e.sets).reduce((sum,e) =>
      sum + e.sets.reduce((a,s) => a + nv(s.weight)*(nv(s.reps)||nv(s.leftReps)+nv(s.rightReps)), 0), 0);
  }

  function entryDetail(e) {
    if (e.type === "cardio") {
      const parts = [];
      if (e.incline) parts.push(`Incline ${e.incline}%`);
      if (e.speed)   parts.push(`Speed ${e.speed} mph`);
      if (e.time)    parts.push(`${e.time} min`);
      return parts.join(" · ") || "—";
    }
    if (!e.sets) return "—";
    return e.sets.map((s,i) => {
      const w  = nv(s.weight);
      const lr = s.leftReps  != null && s.leftReps  !== "" ? `L${nv(s.leftReps)} R${nv(s.rightReps)}` : null;
      const r  = lr || (nv(s.reps) > 0 ? `${nv(s.reps)} reps` : null);
      if (!w && !r) return null;
      return `Set ${i+1}: ${w ? w+"lb" : "—"}${r ? " × "+r : ""}`;
    }).filter(Boolean).join("  |  ") || "—";
  }

  if (byDay.length === 0) return (
    <div style={S.page}>
      <button style={{...S.back,marginBottom:24}} onClick={onBack}><ArrowLeft size={16}/> Home</button>
      <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>History</h2>
      <div style={{...S.surf,padding:24,textAlign:"center",marginTop:20}}>
        <p style={{...S.muted,fontSize:14}}>No workouts logged yet. Complete your first session to see history here.</p>
      </div>
    </div>
  );

  return (
    <div style={S.page}>
      <button style={{...S.back,marginBottom:18}} onClick={onBack}><ArrowLeft size={16}/> Home</button>
      <h2 style={{fontSize:20,fontWeight:700,letterSpacing:"0.08em",textTransform:"uppercase",...S.text,marginBottom:4}}>History</h2>
      <p style={{fontSize:14,marginBottom:20,...S.muted}}>{byDay.length} workout {byDay.length===1?"day":"days"} logged.</p>

      <div style={{display:"flex",flexDirection:"column",gap:10}}>
        {byDay.map(([date, entries]) => {
          const isOpen = !!expanded[date];
          const total  = dayTotal(entries);
          const isToday = date === todayStr();

          return (
            <div key={date} style={{...S.surf,overflow:"hidden"}}>

              {/* Day header row — tap to expand */}
              <button onClick={()=>toggle(date)}
                style={{width:"100%",background:"transparent",border:"none",cursor:"pointer",padding:"14px 16px",
                        display:"flex",alignItems:"center",justifyContent:"space-between",gap:12}}>
                <div style={{textAlign:"left"}}>
                  <div style={{display:"flex",alignItems:"center",gap:8}}>
                    <span style={{fontSize:15,fontWeight:600,...S.text}}>
                      {isToday ? "Today" : fmtDate(date)}
                    </span>
                    {isToday && <span style={{fontSize:10,letterSpacing:"0.1em",textTransform:"uppercase",color:"#D9A441",border:"1px solid #D9A441",borderRadius:9999,padding:"2px 6px"}}>Today</span>}
                  </div>
                  <div style={{fontSize:12,marginTop:2,...S.muted}}>
                    {entries.length} {entries.length===1?"activity":"activities"}
                    {total > 0 ? ` · ${Math.round(total).toLocaleString()} lb` : ""}
                  </div>
                </div>
                <div style={{display:"flex",alignItems:"center",gap:10}}>
                  {/* delete whole day */}
                  <span onClick={ev=>{ev.stopPropagation(); if(window.confirm(`Delete all ${entries.length} activities on ${isToday?"today":fmtDate(date)}?`)) onDeleteDay(date);}}
                    style={{color:"#6B2E28",cursor:"pointer",display:"flex",alignItems:"center"}}>
                    <Trash2 size={15}/>
                  </span>
                  <span style={S.muted}>{isOpen ? <ChevronUp size={16}/> : <ChevronDown size={16}/>}</span>
                </div>
              </button>

              {/* Expanded activity list */}
              {isOpen && (
                <div style={{borderTop:"1px solid #2E2C28"}}>
                  {entries.map(e => (
                    <div key={e.id} style={{padding:"12px 16px",borderBottom:"1px solid #2A2825",display:"flex",alignItems:"flex-start",gap:10}}>
                      <Dot cat={e.cat} size={9} style={{marginTop:4,flexShrink:0}}/>
                      <div style={{flex:1,minWidth:0}}>
                        <div style={{display:"flex",alignItems:"center",gap:8,flexWrap:"wrap"}}>
                          <span style={{fontSize:14,fontWeight:600,...S.text}}>{e.name}</span>
                          {e.rating && (
                            <span style={{fontSize:10,color:RATING_COLOR[e.rating],border:`1px solid ${RATING_COLOR[e.rating]}`,borderRadius:9999,padding:"1px 6px",whiteSpace:"nowrap"}}>
                              {RATING_LABEL[e.rating]}
                            </span>
                          )}
                        </div>
                        <div style={{fontSize:12,marginTop:3,color:"#8A8478",lineHeight:1.5,wordBreak:"break-word"}}>
                          {entryDetail(e)}
                        </div>
                      </div>
                      <button onClick={()=>{ if(window.confirm(`Delete ${e.name}?`)) onDeleteEntry(e.id); }}
                        style={{background:"transparent",border:"none",cursor:"pointer",color:"#6B2E28",padding:0,flexShrink:0}}>
                        <Trash2 size={14}/>
                      </button>
                    </div>
                  ))}
                </div>
              )}

            </div>
          );
        })}
      </div>
    </div>
  );
}

export default function WorkoutTracker() {
  const [ready,      setReady]      = useState(false);
  const [screen,     setScreen]     = useState("home");
  const [profile,    setProfile]    = useState({ name:"", heightIn:"", weightLb:"" });
  const [log,        setLog]        = useState([]);
  const [weightLog,  setWeightLog]  = useState([]);
  const [acts,       setActs]       = useState(BUILT_IN);
  const [activeAct,  setActiveAct]  = useState(null);

  useEffect(() => {
    (async () => {
      const p  = await sGet("il_p");
      const l  = await sGet("il_l");
      const wl = await sGet("il_wl");
      const a  = await sGet("il_acts");
      if (p)  setProfile(p);
      if (l)  setLog(l);
      if (wl) setWeightLog(wl);
      setActs(a || BUILT_IN);
      setReady(true);
    })();
  }, []);

  const ptmr = useRef(null);
  const handleProfile = useCallback(next => {
    setProfile(next);
    clearTimeout(ptmr.current);
    ptmr.current = setTimeout(async () => {
      await sSet("il_p", next);
      const w = nv(next.weightLb);
      if (!w) return;
      const today = todayStr();
      setWeightLog(prev => {
        const idx = prev.findIndex(d => d.date === today);
        const updated = idx >= 0
          ? prev.map((d,i) => i===idx ? {...d, weight:w} : d)
          : [...prev, {date:today, weight:w}].sort((a,b) => a.date.localeCompare(b.date));
        sSet("il_wl", updated);
        return updated;
      });
    }, 700);
  }, []);

  const handleSave = useCallback(async rec => {
    setLog(prev => { const n = [...prev, rec]; sSet("il_l", n); return n; });
    setActiveAct(null);
    setScreen("list");
  }, []);

  const handleAddAct  = useCallback(act  => { setActs(prev => { const n=[...prev,act];           sSet("il_acts",n); return n; }); }, []);
  const handleDelAct  = useCallback(name => { setActs(prev => { const n=prev.filter(a=>a.name!==name); sSet("il_acts",n); return n; }); }, []);
  const lastEntryFor  = useCallback(name => [...log].filter(e=>e.name===name).sort((a,b)=>b.id-a.id)[0]||null, [log]);

  const handleDeleteEntry = useCallback(id => {
    setLog(prev => { const n = prev.filter(e => e.id !== id); sSet("il_l", n); return n; });
  }, []);

  const handleDeleteDay = useCallback(date => {
    setLog(prev => { const n = prev.filter(e => e.date !== date); sSet("il_l", n); return n; });
  }, []);

  if (!ready) return (
    <div style={{background:"#1C1B1A",minHeight:"100vh",display:"flex",alignItems:"center",justifyContent:"center",color:"#8A8478",fontSize:14}}>
      Loading…
    </div>
  );

  return (
    <div style={{background:"#1C1B1A",color:"#F2EFE9",minHeight:"100vh",fontFamily:"-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"}}>
      {screen==="home" &&
        <HomeScreen profile={profile} onProfile={handleProfile} log={log} weightLog={weightLog} acts={acts} onGo={s=>setScreen(s)}/>}
      {screen==="list" &&
        <ListScreen acts={acts} log={log} onHome={()=>setScreen("home")} onPick={a=>{setActiveAct(a);setScreen("activity");}}/>}
      {screen==="activity" && activeAct &&
        <ActivityScreen activity={activeAct} lastEntry={lastEntryFor(activeAct.name)}
          onBack={()=>{setActiveAct(null);setScreen("list");}}
          onHome={()=>{setActiveAct(null);setScreen("home");}}
          onSave={handleSave}/>}
      {screen==="manage" &&
        <ManageScreen acts={acts} onBack={()=>setScreen("home")} onAdd={handleAddAct} onDelete={handleDelAct}/>}
      {screen==="graph" &&
        <GraphScreen weightLog={weightLog} onBack={()=>setScreen("home")}/>}
      {screen==="history" &&
        <HistoryScreen log={log} onBack={()=>setScreen("home")} onDeleteEntry={handleDeleteEntry} onDeleteDay={handleDeleteDay}/>}
    </div>
  );
}
