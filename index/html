/* ── NumField ── */
function NumField({ label, fkey, value, onChange, suffix, carried }) {
  return (
    <label style={{display:"block"}}>
      <span style={S.eyebrow}>
        {label}
        {carried && <span style={{color:"#E5493D",textTransform:"none",marginLeft:6}}>· carried over</span>}
      </span>
      <div style={{position:"relative"}}>
        <input type="number" inputMode="decimal"
          value={value} placeholder="0"
          onChange={e => onChange(fkey, e.target.value)}
          style={{...S.ni, ...(carried ? S.niCarried : {}), paddingRight: suffix ? 40 : 12}}
        />
        {suffix && <span style={{position:"absolute",right:10,top:"50%",transform:"translateY(-50%)",fontSize:12,...S.muted,fontFamily:"'Courier New',Courier,monospace"}}>{suffix}</span>}
      </div>
    </label>
  );
}

/* ── Dot ── */
function Dot({ cat, size=11 }) {
  return <span style={{width:size,height:size,background:CAT_COLOR[cat],borderRadius:"50%",display:"inline-block",flexShrink:0}}/>;
}

