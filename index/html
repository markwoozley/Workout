function buildOrder(acts) {
  const treadmill = acts.filter(a => a.cat === "Cardio");
  const cats = ["Arm & Shoulder","Back","Leg","Core"];
  const bc = {};
  cats.forEach(c => { bc[c] = acts.filter(a => a.cat === c).sort((a,b) => a.name.localeCompare(b.name)); });
  const order = [...treadmill];
  let added = true;
  while (added) {
    added = false;
    cats.forEach(c => { if (bc[c] && bc[c].length) { order.push(bc[c].shift()); added = true; } });
  }
  return order;
}

/* ── utils ── */
function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function fmtDate(s) {
  const [y,m,d] = s.split("-").map(Number);
  return new Date(y,m-1,d).toLocaleDateString(undefined,{month:"short",day:"numeric"});
}
function nv(v) { const f = parseFloat(v); return isFinite(f) ? f : 0; }
function calcBMI(h,w) { return (!h||!w) ? null : 703*w/(h*h); }
function bmiLabel(v) { return v<18.5?"Underweight":v<25?"Normal":v<30?"Overweight":"Obese"; }
function blankEntry() {
  return {
    incline:"", speed:"", time:"", rating:null,
    incCarried:false, spdCarried:false, incTouched:false, spdTouched:false,
    sets:[0,1,2].map(()=>({ weight:"",reps:"",leftReps:"",rightReps:"",carried:false,touched:false }))
  };
}

/* ── storage: window.storage when published, in-memory fallback ── */
const _mem = {};
async function sGet(key) {
  if (window.storage) {
    try { const r = await window.storage.get(key, false); return r && r.value ? JSON.parse(r.value) : null; } catch(e) {}
  }
  return _mem[key] !== undefined ? _mem[key] : null;
}
async function sSet(key, val) {
  _mem[key] = val;
  if (window.storage) {
    try { await window.storage.set(key, JSON.stringify(val), false); } catch(e) {}
  }
}

